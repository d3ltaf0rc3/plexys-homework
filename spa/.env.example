# Corteza server the dev server proxies /api and /auth to (npm run dev only).
# Sign-in uses Corteza's default auth client, so no client ID or secret is
# needed. Corteza must allow this origin: AUTH_DEFAULT_REDIRECT_URIS in ../.env
CORTEZA_URL=http://localhost:18080

# Namespace slug
VITE_NAMESPACE=plexys-hw
