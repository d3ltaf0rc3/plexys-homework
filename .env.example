# General settings
DOMAIN=localhost:18080
VERSION=2026.9

# Database connection
DB_USER=corteza
DB_PASSWORD=corteza
DB_NAME=corteza

# Server settings
HTTP_WEBAPP_ENABLED=true
ACTIONLOG_ENABLED=true

# TODO: generate with `openssl rand -hex 32`
AUTH_JWT_SECRET=

HTTP_WEBAPP_LIST=admin,compose,workflow,reporter,privacy,tickets
VITE_NAMESPACE=plexys-hw

# Not needed when the app is only served by Corteza.
AUTH_DEFAULT_REDIRECT_URIS=http://localhost:5173
